<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>助人自助 AAC 溝通表達系統</title>
    <style>
        /* 全局設定與 CSS 變數 */
        :root {
            --primary-bg: #f4f9f4;
            --card-bg: #ffffff;
            --text-color: #1a1a1a;
            --green-active: #4CAF50;
            --red-danger: #f44336;
            --blue-action: #2196F3;
            --shadow: 0 8px 24px rgba(0,0,0,0.15);
            --border-radius: 24px;
        }

        * {
            box-sizing: border-box;
            font-family: "Microsoft JhengHei", "PingFang HK", "Helvetica Neue", sans-serif;
            user-select: none; /* 防止意外選取文字 */
        }

        body {
            margin: 0;
            padding: 20px;
            background-color: var(--primary-bg);
            color: var(--text-color);
            font-size: 32px; /* 滿足字體最少32px要求 */
            overflow-x: hidden; /* 不可出現橫向捲動列 */
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* 隱藏/顯示頁面 */
        .page {
            display: none;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            animation: fadeIn 0.4s ease;
        }

        .page.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* 頂部控制列 */
        .top-controls {
            width: 100%;
            display: flex;
            justify-content: flex-end;
            margin-bottom: 20px;
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            pointer-events: none;
        }

        .top-controls button {
            pointer-events: auto;
        }

        /* 標題設計 */
        h1.main-title {
            font-size: 64px;
            text-align: center;
            color: #2c3e50;
            margin: 40px 0;
            font-weight: 900;
        }

        h2.section-title {
            font-size: 48px;
            margin: 20px 0;
            color: #34495e;
            width: 100%;
            text-align: left;
            border-left: 12px solid var(--green-active);
            padding-left: 20px;
        }

        /* 圖卡容器：響應式 Grid 排版，自動適應設備 */
        .card-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            width: 100%;
            padding: 20px 0;
        }

        /* 共通圖卡設計：最少 220px x 220px */
        .card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            min-width: 240px;
            min-height: 240px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            cursor: pointer;
            border: 8px solid transparent; /* 預留邊框空間 */
            transition: transform 0.2s, border-color 0.2s, background-color 0.2s;
            position: relative;
        }

        .card:active {
            transform: scale(0.95);
        }

        /* 圖卡內容排版 */
        .card .emoji {
            font-size: 90px;
            margin-bottom: 15px;
            line-height: 1;
            transition: transform 0.2s;
        }

        .card .text {
            font-size: 36px;
            font-weight: bold;
            text-align: center;
            word-wrap: break-word;
        }

        /* 勾號樣式 */
        .card .tick-mark {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 40px;
            display: none;
            background: #fff;
            border-radius: 50%;
            padding: 2px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            z-index: 10;
        }

        /* 選取狀態 (綠色外框與勾號) */
        .card.selected {
            border-color: var(--green-active);
            background-color: #f0fdf0;
        }
        .card.selected .tick-mark {
            display: block;
        }

        /* 表達動畫效果 */
        .card.expressing {
            border-color: var(--blue-action);
            background-color: #e3f2fd;
            transform: scale(0.95);
        }
        .card.expressing .emoji {
            transform: scale(1.2);
        }

        /* 大按鈕樣式 */
        .action-btn {
            font-size: 40px;
            font-weight: bold;
            padding: 20px 50px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 15px;
            transition: transform 0.2s;
            color: white;
        }
        
        .action-btn:active { transform: scale(0.95); }

        .green-btn { background-color: var(--green-active); }
        .blue-btn { background-color: var(--blue-action); }
        .red-btn { background-color: var(--red-danger); }
        .dark-btn { background-color: #424242; font-size: 28px; padding: 15px 30px;}

        /* 頁面底部固定區域 */
        .bottom-bar {
            margin-top: 40px;
            padding: 20px;
            display: flex;
            justify-content: center;
            gap: 30px;
            width: 100%;
        }

        /* 右下角懸浮按鈕：重選活動 */
        .floating-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 100;
        }

        /* 第四頁大圖展示 */
        .final-view .card {
            min-width: 300px;
            min-height: 300px;
            border-color: var(--green-active);
        }
        .final-view .emoji { font-size: 120px; }
        .final-view .text { font-size: 48px; }

        /* 眼動儀注視進度條 (SVG) */
        .gaze-progress-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 140px;
            height: 140px;
            pointer-events: none; /* 避免干擾滑鼠事件 */
            z-index: 999;
            background: rgba(255,255,255,0.7);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 15px rgba(0,0,0,0.2);
        }
        
        .gaze-svg {
            transform: rotate(-90deg);
        }
    </style>
</head>
<body>

    <!-- 右上角全螢幕按鈕 -->
    <div class="top-controls">
        <button id="btn-fullscreen" class="action-btn dark-btn gaze-target">⛶ 全螢幕</button>
    </div>

    <!-- ==================== 第一頁：選擇模式 ==================== -->
    <div id="page-1" class="page active">
        <h1 class="main-title">助人自助 AAC 溝通表達系統</h1>
        <div class="card-container" style="margin-top: 50px;">
            <div class="card gaze-target mode-btn" onclick="setMode('eye')">
                <div class="emoji">👁️</div>
                <div class="text">眼動儀模式</div>
                <div style="font-size: 24px; color: #666; margin-top: 15px;">(凝視2秒自動選取)</div>
            </div>
            <div class="card gaze-target mode-btn" onclick="setMode('touch')">
                <div class="emoji">👆</div>
                <div class="text">觸控模式</div>
                <div style="font-size: 24px; color: #666; margin-top: 15px;">(點擊或觸控螢幕)</div>
            </div>
        </div>
    </div>

    <!-- ==================== 第二頁：選擇活動 ==================== -->
    <div id="page-2" class="page">
        <h1 class="main-title">請選擇活動</h1>
        <div id="activities-container" class="card-container">
            <!-- JavaScript 自動生成活動卡片 -->
        </div>
        <div class="bottom-bar">
            <button id="btn-confirm-act" class="action-btn green-btn gaze-target" onclick="confirmActivity()">✅ 確定</button>
        </div>
    </div>

    <!-- ==================== 第三頁：AAC 圖卡選擇 ==================== -->
    <div id="page-3" class="page">
        <h1 class="main-title">請選擇要表達的圖卡</h1>
        
        <!-- 圖卡選擇區 -->
        <div id="aac-cards-container" class="card-container" style="padding-bottom: 120px;">
            <!-- JavaScript 自動生成 AAC 圖卡 -->
        </div>

        <!-- 底部/懸浮控制 -->
        <div class="bottom-bar" style="position: fixed; bottom: 0; left: 0; background: rgba(244, 249, 244, 0.95); margin: 0; box-shadow: 0 -4px 10px rgba(0,0,0,0.1); justify-content: center; z-index: 50;">
            <button class="action-btn green-btn gaze-target" onclick="confirmSelection()">✅ 確認選擇</button>
        </div>
        <button class="action-btn blue-btn gaze-target floating-btn" onclick="backToActivities()">🔄 重選活動</button>
    </div>

    <!-- ==================== 第四頁：進行表達 ==================== -->
    <div id="page-4" class="page">
        <h1 class="main-title">我的表達</h1>
        <h2 style="text-align: center; color: #666; margin-top: -20px; margin-bottom: 30px;">(點擊或凝視圖卡進行發聲)</h2>
        
        <div id="final-cards-container" class="card-container final-view">
            <!-- JavaScript 自動生成可發聲的已選圖卡 -->
        </div>
        <div class="bottom-bar" style="margin-top: 60px;">
            <button class="action-btn blue-btn gaze-target" onclick="backToAAC()">⬅️ 返回重選</button>
            <button class="action-btn red-btn gaze-target" onclick="startOver()">🏠 回到主頁</button>
        </div>
    </div>

    <script>
        // ==================== 1. 系統數據設定 ====================
        const aacData = [
            { id: 1, title: '表達需要', items: [
                { emoji: '🧃', text: '我想飲水' }, { emoji: '🍎', text: '我想食嘢' }, { emoji: '😴', text: '我想休息' },
                { emoji: '🚻', text: '我要去廁所' }, { emoji: '🙋', text: '我要幫忙' }, { emoji: '✅', text: '我完成了' }
            ]},
            { id: 2, title: '季節穿衣', items: [
                { emoji: '☀️', text: '夏天' }, { emoji: '🌧️', text: '雨天' }, { emoji: '❄️', text: '冬天' },
                { emoji: '👕', text: '短袖衫' }, { emoji: '🧥', text: '外套' }, { emoji: '☂️', text: '雨衣' }
            ]},
            { id: 3, title: '課室整理', items: [
                { emoji: '✅', text: '收拾玩具' }, { emoji: '✅', text: '抹桌子' }, { emoji: '✅', text: '掃地' },
                { emoji: '✅', text: '放回原位' }, { emoji: '✅', text: '丟垃圾' }, { emoji: '✅', text: '整理書架' }
            ]},
            { id: 4, title: '清潔用品', items: [
                { emoji: '🧹', text: '掃把' }, { emoji: '🪣', text: '水桶' }, { emoji: '🧽', text: '海綿' },
                { emoji: '🧴', text: '清潔噴霧' }, { emoji: '🧻', text: '抹布' }, { emoji: '🗑️', text: '垃圾桶' }
            ]},
            { id: 5, title: '求助表達', items: [
                { emoji: '🙋', text: '幫幫我' }, { emoji: '❓', text: '我不明白' }, { emoji: '😟', text: '我遇到困難' },
                { emoji: '🙏', text: '請教我' }, { emoji: '⏳', text: '我等緊幫忙' }, { emoji: '✅', text: '我識做啦' }
            ]},
            { id: 6, title: '禮貌用語', items: [
                { emoji: '😊', text: '早晨' }, { emoji: '👋', text: '你好' }, { emoji: '🙏', text: '謝謝' },
                { emoji: '😊', text: '唔該' }, { emoji: '🤝', text: '一齊做' }, { emoji: '👋', text: '再見' }
            ]},
            { id: 7, title: '關愛行動', items: [
                { emoji: '💧', text: '倒水給同學' }, { emoji: '📦', text: '派物資' }, { emoji: '🪑', text: '幫手收拾' },
                { emoji: '🤲', text: '拾起物品' }, { emoji: '💬', text: '關心同學' }, { emoji: '👏', text: '鼓勵同學' }
            ]},
            { id: 8, title: '工作崗位', items: [
                { emoji: '📦', text: '分類員' }, { emoji: '🎁', text: '包裝員' }, { emoji: '🚚', text: '物資運送員' },
                { emoji: '🧹', text: '清潔員' }, { emoji: '📋', text: '品質檢查員' }
            ]},
            { id: 9, title: '工作流程', items: [
                { emoji: '①', text: '取物資' }, { emoji: '②', text: '分類' }, { emoji: '③', text: '傳遞' },
                { emoji: '④', text: '包裝' }, { emoji: '⑤', text: '檢查' }, { emoji: '⑥', text: '收拾' }
            ]},
            { id: 10, title: '工作難題', items: [
                { emoji: '📦', text: '包裝袋打不開' }, { emoji: '🍪', text: '物品跌落地' }, { emoji: '🚪', text: '通道受阻' },
                { emoji: '❓', text: '找不到用品' }, { emoji: '📦', text: '放錯物品' }, { emoji: '🤔', text: '不知道下一步' }
            ]},
            { id: 11, title: '休息活動', items: [
                { emoji: '🎵', text: '聽音樂' }, { emoji: '🧘', text: '伸展' }, { emoji: '🥨', text: '吃小食' },
                { emoji: '🚶', text: '散步' }, { emoji: '💧', text: '飲水' }, { emoji: '😌', text: '休息' }
            ]},
            { id: 12, title: '工作評估', items: [
                { emoji: '😁', text: '我做得很好' }, { emoji: '🙂', text: '我做得到' }, { emoji: '😐', text: '需要幫助' },
                { emoji: '💪', text: '下次再努力' }, { emoji: '🔄', text: '想試新工作' }, { emoji: '🏆', text: '完成工作' }
            ]}
        ];

        // 系統狀態變數
        let currentMode = 'touch';
        let tempActivityId = null; 
        let currentActivityId = null;
        let selectedCards = []; // 存放已選擇的圖卡資料

        // ==================== 2. 基本頁面導航 ====================
        function switchPage(pageId) {
            document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');
            window.scrollTo(0, 0);
        }

        // 全螢幕切換
        document.getElementById('btn-fullscreen').addEventListener('click', () => {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => console.log(err));
            } else {
                if (document.exitFullscreen) document.exitFullscreen();
            }
        });

        // ==================== 語音功能 (強化粵語/廣東話匹配) ====================
        let availableVoices = [];
        
        function loadVoices() {
            if ('speechSynthesis' in window) {
                availableVoices = window.speechSynthesis.getVoices();
            }
        }
        
        if ('speechSynthesis' in window) {
            loadVoices();
            if (speechSynthesis.onvoiceschanged !== undefined) {
                speechSynthesis.onvoiceschanged = loadVoices;
            }
        }

        // 語音朗讀功能
        function speakText(text) {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel(); // 停止當前語音
            
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'zh-HK'; 
            utterance.rate = 0.85;    
            
            if (availableVoices.length > 0) {
                const hkVoice = availableVoices.find(voice => 
                    voice.lang.includes('zh-HK') || 
                    voice.lang.includes('zh_HK') || 
                    voice.name.includes('Cantonese') || 
                    voice.name.includes('香港') || 
                    voice.name.includes('廣東話')
                );
                if (hkVoice) {
                    utterance.voice = hkVoice;
                }
            }

            window.speechSynthesis.speak(utterance);
        }

        // ==================== 3. 頁面邏輯 ====================

        // [第一頁] 設定操作模式
        function setMode(mode) {
            currentMode = mode;
            speakText("請選擇活動"); 
            renderActivities();
            switchPage('page-2');
        }

        // [第二頁] 渲染活動列表
        function renderActivities() {
            const container = document.getElementById('activities-container');
            container.innerHTML = '';
            tempActivityId = null;

            aacData.forEach(act => {
                const card = document.createElement('div');
                card.className = 'card gaze-target act-card';
                const icon = act.items[0].emoji; 
                card.innerHTML = `
                    <div class="emoji">${icon}</div>
                    <div class="text">${act.title}</div>
                `;
                
                card.onclick = () => {
                    document.querySelectorAll('.act-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    tempActivityId = act.id;
                    speakText(act.title);
                };
                
                container.appendChild(card);
            });
        }

        // [第二頁] 確定選擇活動
        function confirmActivity() {
            if (!tempActivityId) {
                speakText("請先選擇一個活動");
                return;
            }
            currentActivityId = tempActivityId;
            selectedCards = []; // 清空之前的選擇
            renderAAC();
            switchPage('page-3');
            speakText("請選擇圖卡");
        }

        // [第三頁] 渲染 AAC 圖卡選擇 (點擊/凝視進行切換)
        function renderAAC() {
            const activity = aacData.find(a => a.id === currentActivityId);
            const container = document.getElementById('aac-cards-container');
            container.innerHTML = '';

            activity.items.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = 'card gaze-target aac-item-card';
                card.dataset.index = index;
                
                card.innerHTML = `
                    <div class="tick-mark">✅</div>
                    <div class="emoji">${item.emoji}</div>
                    <div class="text">${item.text}</div>
                `;

                // 檢查是否已選取，以維持重返此頁時的狀態
                const isSelected = selectedCards.some(c => c.text === item.text);
                if (isSelected) {
                    card.classList.add('selected');
                }

                card.onclick = () => {
                    const existingIndex = selectedCards.findIndex(c => c.text === item.text);
                    
                    if (existingIndex > -1) {
                        // 如果已經選取，則取消選取
                        selectedCards.splice(existingIndex, 1);
                        card.classList.remove('selected');
                        speakText("取消"); 
                    } else {
                        // 如果尚未選取，則加入選取名單
                        selectedCards.push({ emoji: item.emoji, text: item.text, originalIndex: index });
                        card.classList.add('selected');
                        speakText(item.text); 
                    }
                };

                container.appendChild(card);
            });
        }

        // 重選活動
        function backToActivities() {
            selectedCards = [];
            renderActivities();
            switchPage('page-2');
        }

        // [第三頁] 確認選擇，進入第四頁表達區
        function confirmSelection() {
            if (selectedCards.length === 0) {
                speakText("請先選擇最少一張圖卡");
                return;
            }
            renderFinalExpressionCards();
            switchPage('page-4');
            speakText("可以開始表達");
        }

        // [第四頁] 渲染最終表達圖卡 (具備發聲功能)
        function renderFinalExpressionCards() {
            const container = document.getElementById('final-cards-container');
            container.innerHTML = '';

            // 依照原圖卡的順序排列
            selectedCards.sort((a, b) => a.originalIndex - b.originalIndex);

            selectedCards.forEach(item => {
                const card = document.createElement('div');
                card.className = 'card gaze-target'; 
                card.innerHTML = `
                    <div class="emoji">${item.emoji}</div>
                    <div class="text">${item.text}</div>
                `;
                
                // 點擊/凝視時，發出語音並顯示視覺回饋
                card.onclick = () => {
                    speakText(item.text);
                    
                    // 加入視覺回饋動畫 (閃爍藍色/縮放)
                    card.classList.add('expressing');
                    setTimeout(() => {
                        card.classList.remove('expressing');
                    }, 400);
                };

                container.appendChild(card);
            });
        }

        function backToAAC() {
            renderAAC(); // 重新渲染以確保選取狀態正確
            switchPage('page-3');
        }

        function startOver() {
            selectedCards = [];
            switchPage('page-1');
        }

        // ==================== 4. 眼動儀模擬系統 (滑鼠懸停2秒觸發) ====================
        let gazeTimeout = null;
        let gazeAnimation = null;
        let currentTarget = null;
        let indicatorEl = null;
        let gazeStartTime = 0;
        const GAZE_DURATION = 2000; // 2秒

        document.addEventListener('mouseover', (e) => {
            if (currentMode !== 'eye') return;
            
            const target = e.target.closest('.gaze-target');
            if (target && target !== currentTarget) {
                clearGaze();
                currentTarget = target;
                startGazeVisuals(target);
            }
        });

        document.addEventListener('mouseout', (e) => {
            if (currentMode !== 'eye') return;
            const target = e.target.closest('.gaze-target');
            
            if (target) {
                if (!target.contains(e.relatedTarget)) {
                    clearGaze();
                }
            }
        });

        function startGazeVisuals(target) {
            gazeStartTime = Date.now();
            
            indicatorEl = document.createElement('div');
            indicatorEl.className = 'gaze-progress-container';
            indicatorEl.innerHTML = `
                <svg width="120" height="120" class="gaze-svg">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#e0e0e0" stroke-width="12" />
                    <circle id="gaze-circle-progress" cx="60" cy="60" r="50" fill="none" stroke="${getComputedStyle(document.body).getPropertyValue('--green-active').trim()}" stroke-width="12" stroke-dasharray="314" stroke-dashoffset="314" />
                </svg>
            `;
            
            if(window.getComputedStyle(target).position === 'static') {
                target.style.position = 'relative';
            }
            target.appendChild(indicatorEl);

            gazeAnimation = requestAnimationFrame(updateGazeProgress);
        }

        function updateGazeProgress() {
            if (!currentTarget || !indicatorEl) return;
            
            const elapsed = Date.now() - gazeStartTime;
            const circle = document.getElementById('gaze-circle-progress');
            
            if (elapsed >= GAZE_DURATION) {
                const targetToClick = currentTarget;
                clearGaze(); 
                targetToClick.click(); 
            } else {
                const percentage = elapsed / GAZE_DURATION;
                const offset = 314 - (314 * percentage);
                if (circle) circle.style.strokeDashoffset = offset;
                
                gazeAnimation = requestAnimationFrame(updateGazeProgress);
            }
        }

        function clearGaze() {
            if (gazeAnimation) cancelAnimationFrame(gazeAnimation);
            if (indicatorEl && indicatorEl.parentNode) {
                indicatorEl.parentNode.removeChild(indicatorEl);
            }
            currentTarget = null;
            indicatorEl = null;
        }

    </script>
</body>
</html>
